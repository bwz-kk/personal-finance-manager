# SQLite file lives locally and is never committed (see .gitignore).
DATABASE_URL="file:./dev.db"

# Localhost only — this app has no auth and must never be reachable from the
# network. See SECURITY.md.
HOST=127.0.0.1
PORT=4000

# Must match the web app's dev server origin.
CORS_ORIGIN="http://localhost:5173"
